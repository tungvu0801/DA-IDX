ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional — only needed for `python main.py --sync-robinhood`.
# See robinhood_sync.py for important caveats before setting these.
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=

# Optional — only needed for the AI Technical Agent (plain-English
# explanations on the web dashboard). Everything else works without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Only needed if your key is an organization-level key not scoped to a
# workspace (Anthropic will return a 400 asking for this if so).
ANTHROPIC_WORKSPACE_ID=

# Optional — tune how often/when the AI agent is allowed to run. Defaults
# shown below match config.py; uncomment to override.
# AI_ANALYSIS_ATTENTION_THRESHOLD=75
# AI_ANALYSIS_CACHE_MINUTES=30
# AI_MAX_CALLS_PER_HOUR=10
# AI_MAX_CALLS_PER_DAY=30
# AI_REANALYZE_PRICE_CHANGE_PERCENT=2.0
# AI_REANALYZE_ATTENTION_CHANGE=10

# Optional — Stage 2.6 event intelligence. Without this key, CPI/PPI/
# Employment Situation/PCE calendar events are honestly reported as
# unavailable (FOMC calendar and Alpaca corporate actions need no key and
# work regardless). Get a free key at
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# EVENT_LOOKAHEAD_DAYS=14
# EVENT_LOOKBACK_DAYS=7

# Optional — Stage 2.7C read-only portfolio awareness (off by default). Requires the separate
# local gateway (../rh_gateway, `python -m rh_gateway serve`). No Robinhood credentials or account
# numbers ever go in this file: the gateway holds them, encrypted with Windows DPAPI.
PORTFOLIO_AWARENESS_ENABLED=false
RH_GATEWAY_URL=http://127.0.0.1:8787
PORTFOLIO_ACCOUNT_ALIAS=holdings
